---
import BlogArticle from '../../components/BlogArticle.astro';
import { publishedBlog } from '../../lib/translations';

export async function getStaticPaths() {
  const { de, enIds } = await publishedBlog();
  return de.map(post => ({
    params: { id: post.id },
    props: { post, altHref: enIds.has(post.id) ? `/en/blog/${post.id}/` : undefined },
  }));
}

const { post, altHref } = Astro.props;
---
<BlogArticle post={post} lang="de" altHref={altHref} />
