---
import GuideArticle from '../../components/GuideArticle.astro';
import { publishedGuides } from '../../lib/translations';

export async function getStaticPaths() {
  const { de, enIds } = await publishedGuides();
  return de.map(guide => ({
    params: { id: guide.id },
    props: { guide, guides: de, altHref: enIds.has(guide.id) ? `/en/guides/${guide.id}/` : undefined },
  }));
}

const { guide, guides, altHref } = Astro.props;
---
<GuideArticle guide={guide} guides={guides} lang="de" altHref={altHref} />
